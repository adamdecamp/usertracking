{
  "name": "raptor-user-tracker",
  "version": "1.2.92",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Test-BuildGate.ps1",
    "build": "vite build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern vendor",
    "test:regression": "node ./scripts/run-regression.mjs",
    "test:fuzz": "node --experimental-strip-types --test tests/fuzz.test.ts",
    "test": "pnpm run test:regression && pnpm run test:fuzz",
    "verify:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Test-BuildGate.ps1"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "next": "16.4.0",
    "pako": "1.0.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "braces": "workspace:3.0.4",
    "eslint": "9.39.4",
    "eslint-config-next": "workspace:16.3.6",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "type": "module"
}
